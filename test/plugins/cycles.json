{
  "name": "edge-cycles", "type": "feature",
  "variables": {"a": "$b", "b": "$c", "c": "$a", "x": "$y", "y": 5, "d": "$d", "e": "$e1", "e1": "$e2", "e2": "$e3", "e3": "$e4", "e4": "$e5", "e5": "$e6", "e6": "$e7", "e7": "$e8", "e8": "$e9", "e9": "$e10", "e10": "$e11", "e11": "$e12", "e12": "$e13", "e13": "$e14", "e14": "$e15", "e15": "$e16", "e16": "$e17", "e17": 1},
  "functions": { "shadow": {"vars": {"y": 1}, "actions": [ {"return": "$y"} ]} },
  "events": {
    "go": {"actions": [ {"add": ["$x", 1]}, {"add": ["$a", 1]}, {"add": ["$d", 1]}, {"add": ["$e", 1]}, {"set": ["$z", "$x"]}, {"add": ["$z", 1]}, {"to_string": "$x"}, {"@shadow": []}, {"return": "$x"} ]},
    "bare": [ "notastring", {"add": [1, 1]} ],
    "bare2": ["eq"],
    "tick": {"args": ["ms"], "actions": [ {"log": "$ms"}, {"random": [1, 6]}, {"delay": 1} ]}
  }
}
